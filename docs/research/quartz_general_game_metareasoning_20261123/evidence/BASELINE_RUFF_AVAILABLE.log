133 + def forecast(model, stage, x):
134 +     lam = model["lambda_wdl_per_ms"]
135 +     dot = lambda a: sum(v * w for v, w in zip(a, x))
136 +     sg = dot(model["one_step_gain_coefficients"][stage])
137 +     sc = max(
138 +         1e-6,
139 +         math.exp(
140 +             max(-20.0, min(10.0, dot(model["one_step_cost_log_coefficients"][stage])))
141 +         )
142 +         * model["one_step_cost_scale"][stage],
143 +     )
144 +     ns = sg - lam * sc
145 +     jg = jc = nj = None
146 +     if stage < 2:
147 +         jg = dot(model["two_step_gain_coefficients"][stage])
148 +         jc = max(
149 +             1e-6,
150 +             math.exp(
151 +                 max(
152 +                     -20.0,
153 +                     min(10.0, dot(model["two_step_cost_log_coefficients"][stage])),
154 +                 )
155 +             )
156 +             * model["two_step_cost_scale"][stage],
157 +         )
158 +         nj = jg - lam * jc
159 +     action = (
160 +         "commit_two"
161 +         if nj is not None and nj > 0 and nj > max(ns, 0)
162 +         else ("single" if ns > 0 else "stop")
163 +     )
164 +     return {
165 +         "action": action,
166 +         "predicted_single_gain": sg,
167 +         "predicted_single_cost_ms": sc,
168 +         "net_single": ns,
169 +         "predicted_joint_gain": jg,
170 +         "predicted_joint_cost_ms": jc,
171 +         "net_joint": nj,
172 +     }
