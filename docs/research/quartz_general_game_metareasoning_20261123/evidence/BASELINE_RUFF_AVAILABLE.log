144 + def beta_fraction_pmf(a, b, n):
145 +     a = F(a)
146 +     b = F(b)
147 +     p = F(1)
148 +     for t in range(n):
149 +         p *= (b + t) / (a + b + t)
150 +     out = [p]
151 +     for k in range(n):
152 +         p *= F(n - k, k + 1) * (a + k) / (b + n - k - 1)
153 +         out.append(p)
154 +     assert sum(out) == 1
155 +     return out
156 +
157 +
158 + def beta_fraction_EVSI(row, world):
159 +     init = row["initial_observations"]
160 +     n = world["extra_draws_per_arm"]
161 +     arms = [(F(2 + sum(seq)), F(2 + len(seq) - sum(seq))) for seq in init]
162 +     weights = []
163 +     for a, b in arms:
164 +         probs = beta_fraction_pmf(a, b, n)
165 +         weights.append([((a + k) / (a + b + n), probs[k]) for k in range(n + 1)])
166 +     support = sorted({v for z in weights for v, p in z})
167 +     before = F(0)
168 +     expected = F(0)
169 +     last = F(0)
170 +     for v in support:
171 +         curr = math.prod(sum(p for score, p in z if score <= v) for z in weights)
172 +         expected += (v - before) * (1 - last)
173 +         before = v
174 +         last = curr
175 +     assert last == 1
176 +     initial = max(a / (a + b) for a, b in arms)
177 +     return expected - initial
178 +
179 +
180 + def sensor_ordered_EVSI(row, world):
181 +     L = world["observation_likelihood_state_outcome_PUBLIC"]
182 +     U = world["utility_state_action_matrix_PUBLIC"]
183 +     b = world["initial_prior"][:]
184 +     for y in row["initial_observations"]:
185 +         b = updated(b, L, y)
186 +     m0 = max(scores(b, U))
187 +     n = world["extra_observations"]
188 +     value = 0.0
189 +     mass = 0.0
190 +     for ys in product(range(3), repeat=n):
191 +         weights = [b[t] * math.prod(L[t][y] for y in ys) for t in range(4)]
192 +         mass += sum(weights)
193 +         value += max(sum(weights[t] * U[t][a] for t in range(4)) for a in range(3))
194 +     assert abs(mass - 1) < 1e-9
195 +     return max(0.0, value - m0)
