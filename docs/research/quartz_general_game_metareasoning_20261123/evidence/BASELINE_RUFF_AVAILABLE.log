25  + def polya_pmf(a, b, n):
26  +     a, b = int(a), int(b)
27  +     p = math.prod((b + j) / (a + b + j) for j in range(n))
28  +     out = [p]
29  +     for k in range(n):
30  +         p = p * ((n - k) / (k + 1)) * ((a + k) / (b + n - k - 1))
31  +         out.append(p)
32  +     assert abs(sum(out) - 1) < 1e-9
33  +     return out
34  +
