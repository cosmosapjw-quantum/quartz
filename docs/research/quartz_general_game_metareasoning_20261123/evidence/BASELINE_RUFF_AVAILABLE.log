215 + def run_batch(exe: Path, requests: list[dict]) -> list[dict]:
216 +     wire = (
217 +         "\n".join(
218 +             json.dumps(q, separators=(",", ":"), sort_keys=True) for q in requests
219 +         )
220 +         + "\n"
221 +         + json.dumps({"cmd": "quit"})
222 +         + "\n"
223 +     )
224 +     result = subprocess.run(
225 +         [str(exe), "--server"],
226 +         input=wire.encode(),
227 +         stdout=subprocess.PIPE,
228 +         stderr=subprocess.PIPE,
229 +         timeout=190,
230 +         check=False,
231 +     )
232 +     if result.returncode != 0:
233 +         raise RuntimeError(
234 +             f"Rust MCTS server failed: {result.returncode}, stderr={result.stderr[-1500:]!r}"
235 +         )
236 +     replies = [
237 +         json.loads(s)
238 +         for s in result.stdout.decode("utf-8", "replace").splitlines()
239 +         if s.strip()
240 +     ]
241 +     if len(replies) != len(requests):
242 +         raise RuntimeError(
243 +             f"root result cardinality mismatch: {len(replies)} vs {len(requests)}"
244 +         )
245 +     for q, r in zip(requests, replies):
246 +         if r.get("error") or r.get("history") != q["history"] or r.get("seed") != 17:
247 +             raise RuntimeError("invalid request/response identity " + str(r)[:420])
