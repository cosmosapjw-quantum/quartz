127 + def nll_grad_hessian(theta, features, targets, l2=0.01):
128 +     t = np.asarray(theta, dtype=np.float64)
129 +     loss = 0.5 * l2 * float(t @ t)
130 +     grad = l2 * t.copy()
131 +     hess = np.eye(len(t)) * l2
132 +     n = len(features)
133 +     assert n > 0 and len(targets) == n
134 +     for x, yi in zip(features, targets):
135 +         z = x @ t
136 +         zm = z.max()
137 +         ez = np.exp(z - zm)
138 +         p = ez / ez.sum()
139 +         loss += (float(np.log(ez.sum()) + zm - z[yi])) / n
140 +         mu = p @ x
141 +         grad += (mu - x[yi]) / n
142 +         xc = x - mu
143 +         hess += (xc.T @ (xc * p[:, None])) / n
144 +     return loss, grad, hess
