104 + def current_x(root, stage):
105 +     row = root["steps"][stage]
106 +     b = row["budget"]
107 +     assert b in (8, 16, 32)
108 +     legal = root["legal_columns_0based"]
109 +     dense = [0.0] * 7
110 +     seen = set()
111 +     for a, p in row["visit_policy"]:
112 +         assert a in legal and a not in seen and p >= 0 and math.isfinite(p)
113 +         dense[a] = float(p)
114 +         seen.add(a)
115 +     z = sum(dense)
116 +     assert abs(z - 1) < 1e-4
117 +     dense = [x / z for x in dense]
118 +     sortedp = sorted(dense, reverse=True)
119 +     h = -sum(x * math.log(x) for x in dense if x > 0) / math.log(7)
120 +     return [
121 +         1.0,
122 +         b / 64,
123 +         h,
124 +         sortedp[0],
125 +         sortedp[0] - sortedp[1],
126 +         len(legal) / 7,
127 +         row["evaluator_calls"] / (b + 1),
128 +         root["ply"] / 42,
129 +         1.0 if root["side_to_move"] == 1 else 0.0,
130 +     ]
