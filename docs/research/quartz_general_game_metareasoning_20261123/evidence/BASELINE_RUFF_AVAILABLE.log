80  + def tactical_from_source(root, initial, ranked, firstbest, firstpi):
81  +     b, heights = replay(root["history"])
82  +     player = root["current_player"]
83  +     if firstbest not in initial:
84  +         firstbest = initial[0]  # plain-full control
85  +     omitted = [c for c in ranked if c not in initial]
86  +     wins = [c for c in omitted if is_winning_next(b, heights, player, c)]
87  +     safe = [
88  +         c for c in omitted if c not in wins and not vulnerability(b, heights, player, c)
89  +     ]
90  +     vuln = vulnerability(b, heights, player, firstbest)
91  +     fixation = max(float(x[1]) for x in firstpi)
92  +     if fixation < 0.5:
93  +         chosen = []
94  +         reason = "fixation_threshold_not_reached"
95  +     elif wins:
96  +         chosen = wins[:2]
97  +         reason = "excluded_immediate_win"
98  +     elif vuln and safe:
