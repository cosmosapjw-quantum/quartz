512 +         "mean_visits": sum(BUDGETS[x[0]] for x in results) / n,
513 +         "stop_budgets": dict(Counter(str(BUDGETS[x[0]]) for x in results)),
514 +         "mean_cost_adjusted_objective": sum(
515 +             x[1] - VALIDATION_COST_PRICE * x[2] for x in results
516 +         )
517 +         / n,
518 +     }
