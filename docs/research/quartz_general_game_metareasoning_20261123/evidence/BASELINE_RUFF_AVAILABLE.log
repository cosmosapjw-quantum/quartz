73  + def bootstrap_12_by16(x, y):
74  +     assert len(x) == len(y) == 192
75  +     groups = defaultdict(list)
76  +     for a, b in zip(x, y):
77  +         assert a["family"] == b["family"]
78  +         groups[a["family"]].append(a["regret"] - b["regret"])
79  +     assert len(groups) == 12 and all(len(t) == 16 for t in groups.values())
80  +     means = [sum(t) / 16 for _, t in sorted(groups.items())]
81  +     rng = random.Random(20261121)
82  +     replicates = sorted(
83  +         sum(rng.choice(means) for _ in range(12)) / 12 for _ in range(3000)
84  +     )
85  +     return {
86  +         "mean_left_minus_right": sum(means) / 12,
87  +         "conditional_family_bootstrap_95": [replicates[74], replicates[2924]],
88  +         "n_families": 12,
89  +     }
