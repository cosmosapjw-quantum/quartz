4  | from pathlib import Path
5  | from fractions import Fraction as F
   - import json,hashlib
   - p=F(3,5);q=F(4,5)
   - brier=p*(1-q)**2+(1-p)*q**2
   - irreducible=p*(1-p)
   - excess=(p-q)**2
   - assert brier==F(7,25)
   - assert irreducible==F(6,25)
   - assert excess==F(1,25)
   - assert brier==irreducible+excess
   - flip=F(1,4)
