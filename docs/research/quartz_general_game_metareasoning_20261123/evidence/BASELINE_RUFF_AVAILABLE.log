154 + def run_rust(exe, reqs):
155 +     start = time.perf_counter()
156 +     data = (
157 +         "\n".join(
158 +             json.dumps(r, separators=(",", ":")) for r in (reqs + [{"cmd": "quit"}])
159 +         )
160 +         + "\n"
161 +     )
162 +     run = subprocess.run(
163 +         [str(exe), "--server"],
164 +         input=data.encode(),
165 +         capture_output=True,
166 +         timeout=240,
167 +         check=True,
168 +         env={**os.environ, "OMP_NUM_THREADS": "2", "MKL_NUM_THREADS": "2"},
169 +     )
170 +     lines = [x for x in run.stdout.decode().splitlines() if x.strip()]
171 +     result = [json.loads(line) for line in lines]
172 +     if len(result) != len(reqs):
173 +         raise RuntimeError(
174 +             f"expecting {len(reqs)} real Rust results; got {len(result)}. stdout_last={lines[-2:]}; stderr_last={run.stderr[-1000:]}"
175 +         )
176 +     return (
177 +         result,
178 +         time.perf_counter() - start,
179 +         run.stderr.decode(errors="replace")[-1500:],
180 +     )
