127 + def recompute_trial(task, policy, i, seed):
128 +     b, u, exps, lam, h = setup(task)
129 +     theta = discrete(b, uniform("state", seed, task["id"], i))
130 +     counts = Counter()
131 +     cost = F(0)
132 +     post = b
133 +     for rem in range(h, 0, -1):
134 +         idx = choose(post, u, exps, lam, rem, policy)
135 +         if idx is None:
136 +             break
137 +         c = exps[idx]
138 +         obs = discrete(
139 +             c[2][theta], uniform("obs", seed, task["id"], i, c[0], counts[c[0]])
140 +         )
141 +         counts[c[0]] += 1
142 +         mass = sum(p * r[obs] for p, r in zip(post, c[2]))
143 +         assert mass > 0
144 +         post = tuple(p * r[obs] / mass for p, r in zip(post, c[2]))
145 +         cost += lam * c[1]
146 +     loss, chosen = terminal_loss(u, theta, post)
147 +     return {
148 +         "state_index": theta,
149 +         "chosen_action": chosen,
150 +         "n_computations": sum(counts.values()),
151 +         "decision_loss": float(loss),
152 +         "priced_compute_cost": float(cost),
153 +     }
