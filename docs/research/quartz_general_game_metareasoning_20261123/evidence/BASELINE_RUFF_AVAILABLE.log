36  + def cdf_max_exact_support_evsi(ab, n):
37  +     start = time.perf_counter_ns()
38  +     if not (2 <= len(ab) <= 4) or not 0 <= n <= 10:
39  +         raise ValueError("bounded source only")
40  +     # Exact rational support under positive INTEGER Beta shapes used in C20 source.
41  +     distributions = []
