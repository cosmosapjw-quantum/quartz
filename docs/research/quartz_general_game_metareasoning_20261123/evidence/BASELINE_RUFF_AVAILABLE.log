220 +                                         writer.writerow(
221 +                                             [
222 +                                                 raw_key,
223 +                                                 unit,
224 +                                                 format(true_gap[unit], ".9g"),
225 +                                                 format(estimated_gap[unit], ".9g"),
226 +                                                 format(regret[unit], ".9g"),
227 +                                                 int(errors[unit]),
228 +                                                 int(covered[unit]),
229 +                                             ]
