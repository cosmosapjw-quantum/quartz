8  +
9  + def upper(arms, budgets):
10 +     mu = [a / (a + b) for a, b in arms]
11 +     win = max(range(len(mu)), key=lambda j: (mu[j], -j))
12 +     var = [
13 +         n * a * b / ((a + b) ** 2 * (a + b + 1) * (a + b + n))
14 +         for (a, b), n in zip(arms, budgets)
15 +     ]
16 +     gross = 0.0
17 +     for j in range(len(mu)):
18 +         if j == win:
19 +             continue
20 +         delta = mu[j] - mu[win]
21 +         gross += 0.5 * (math.sqrt(delta * delta + var[win] + var[j]) + delta)
22 +     return min(max(0.0, gross), 1 - mu[win])
23 +
24 +
25 + def cert(arms, budgets):
26 +     mu = [a / (a + b) for a, b in arms]
27 +     win = max(range(len(mu)), key=lambda j: (mu[j], -j))
28 +     low = arms[win][0] / (sum(arms[win]) + budgets[win])
29 +     high = max(
30 +         (arms[j][0] + budgets[j]) / (sum(arms[j]) + budgets[j])
31 +         for j in range(len(arms))
32 +         if j != win
33 +     )
34 +     return low > high
35 +
