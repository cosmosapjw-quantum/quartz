65  + def query_one(exe, root, history, rule, budget_ms, hard_deadline_s=15):
66  +     wire = protocol_for_history(history, budget_ms, rule)
67  +     proc = subprocess.Popen(
68  +         [str(exe)],
69  +         cwd=root,
70  +         stdin=subprocess.PIPE,
71  +         stdout=subprocess.PIPE,
72  +         stderr=subprocess.PIPE,
73  +         bufsize=0,
74  +         start_new_session=True,
75  +         env={**os.environ, "OMP_NUM_THREADS": "1"},
76  +     )
77  +     began = time.perf_counter()
78  +     output = b""
79  +     status = "TIMEOUT"
80  +     try:
81  +         proc.stdin.write(wire.encode())
82  +         proc.stdin.flush()
83  +         while time.perf_counter() - began < hard_deadline_s:
84  +             if proc.poll() is not None:
85  +                 break
86  +             ready, _, _ = select.select([proc.stdout], [], [], 0.6)
87  +             if not ready:
88  +                 continue
89  +             chunk = os.read(proc.stdout.fileno(), 65536)
90  +             if not chunk:
91  +                 break
92  +             output += chunk
93  +             if len(output) > 250000:
94  +                 status = "TOO_MUCH_OUTPUT"
95  +                 break
96  +             if re.search(rb"(^|\n)[0-9]{1,2},[0-9]{1,2}\r?\n", output):
97  +                 status = "OK"
98  +                 break
99  +         stdout = output.decode("utf-8", errors="replace")
100 +         elapsed_ms = (time.perf_counter() - began) * 1000
101 +         if status == "OK":
102 +             try:
103 +                 parsed = parse_move_and_model(stdout, rule)
104 +                 if parsed["flat_action"] in history:
105 +                     raise ValueError("Rapfi selected an already occupied cell")
106 +                 if not parsed["compatible_weight_reported"]:
107 +                     raise ValueError("loaded NNUE weight identity missing from output")
108 +             except ValueError as exc:
109 +                 return {
110 +                     "status": "INVALID_ENGINE_OUTPUT",
111 +                     "error": str(exc),
112 +                     "elapsed_wall_ms": elapsed_ms,
113 +                     "stdout_prefix": stdout[:3500],
114 +                 }
115 +             return {
116 +                 "status": "OK",
117 +                 "elapsed_wall_ms": elapsed_ms,
118 +                 "wall_budget_requested_ms": budget_ms,
119 +                 "stdout_prefix": stdout[:3500],
120 +                 **parsed,
121 +             }
122 +         return {
123 +             "status": status
124 +             if status != "TIMEOUT" or proc.poll() is None
125 +             else "EXIT_BEFORE_MOVE",
126 +             "elapsed_wall_ms": elapsed_ms,
127 +             "stdout_prefix": stdout[:3500],
128 +             "exitcode_before_end": proc.poll(),
129 +         }
130 +     finally:
131 +         try:
132 +             proc.stdin.write(b"END\n")
133 +             proc.stdin.flush()
134 +         except (BrokenPipeError, ValueError):
135 +             pass
136 +         try:
137 +             proc.wait(timeout=2)
138 +         except subprocess.TimeoutExpired:
139 +             proc.kill()
140 +             proc.wait()
