183 + def summarize_group(positions, scope):
184 +     pairs = [x for x in positions if scope == "pooled" or x["stratum"] == scope]
185 +     if not pairs:
186 +         raise ValueError("no data in stratum")
187 +     output = {
188 +         "n": len(pairs),
189 +         "known_immediate_win_state_count": sum(
190 +             bool(x["exact_legal_immediate_wins"]) for x in pairs
191 +         ),
192 +         "stratum_is_constructed_stress": scope == "tactical_stress",
193 +         "arms": {},
194 +         "paired": {},
195 +     }
196 +     for arm in ARMS:
197 +         records = [x[arm] for x in pairs]
198 +         output["arms"][arm] = {
199 +             "n": len(records),
200 +             "teacher_300ms_agree_count": sum(x["teacher_agree"] for x in records),
201 +             "teacher_600ms_agree_count": sum(
202 +                 x["teacher_secondary_agree"] for x in records
203 +             ),
204 +             "immediate_terminal_win_selected_count": sum(
205 +                 x["is_immediate_win"] for x in records
206 +             ),
207 +             "mean_end_to_end_wall_ms": sum(x["cost_us"] for x in records)
208 +             / len(records)
209 +             / 1000,
210 +             "mean_pure_MCTS_ms": sum(x["pure_search_us"] for x in records)
211 +             / len(records)
212 +             / 1000,
213 +             "mean_full_root_setup_ms": sum(x["full_root_setup_us"] for x in records)
214 +             / len(records)
215 +             / 1000,
216 +             "mean_rules_probe_ms": sum(x["tactical_probe_us"] for x in records)
217 +             / len(records)
218 +             / 1000,
219 +             "mean_final_candidate_count": sum(x["final_active_count"] for x in records)
220 +             / len(records),
221 +             "actually_reactivated_roots": sum(x["added_count"] > 0 for x in records),
222 +             "actually_reactivated_legal_immediate_wins": sum(
223 +                 x["reopened_immediate_win"] for x in records
224 +             ),
225 +             "chosen_action_ge64_count": sum(x["action"] >= 64 for x in records),
226 +         }
227 +     for arm in ARMS:
228 +         if arm == "full32":
229 +             continue
230 +         output["paired"][arm + "_minus_full32"] = pair_summary(pairs, arm, "full32")
231 +         if arm != "evidence":
232 +             output["paired"]["evidence_minus_" + arm] = pair_summary(
233 +                 pairs, "evidence", arm
234 +             )
235 +     return output
