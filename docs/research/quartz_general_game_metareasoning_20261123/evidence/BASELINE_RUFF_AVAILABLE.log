55  +     return {
56  +         "xy": [x, y],
57  +         "flat_action": y * 15 + x,
58  +         "compatible_weight_reported": f"load weight from {expected}" in stdout,
59  +         "saw_loaded_nnue": ("mix9svq nnue: load weight from" in stdout),
60  +         "loaded_expected_weight_name": expected,
61  +         "engine_error_messages": [],
