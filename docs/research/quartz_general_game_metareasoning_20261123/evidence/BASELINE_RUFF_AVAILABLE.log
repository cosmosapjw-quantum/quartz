11 + def betaP(a, b, n):
12 +     p = F(1)
13 +     for i in range(n):
14 +         p *= (b + i) / (a + b + i)
15 +     probabilities = [p]
16 +     for k in range(n):
17 +         p *= F(n - k, k + 1) * (a + k) / (b + n - k - 1)
18 +         probabilities.append(p)
19 +     assert sum(probabilities) == 1
20 +     return probabilities
21 +
22 +
23 + def EVSI(arms, budget):
24 +     probs = [betaP(a, b, n) for (a, b), n in zip(arms, budget)]
25 +     current = max(a / (a + b) for a, b in arms)
26 +     gross = F(0)
27 +     for counts in product(*(range(n + 1) for n in budget)):
28 +         p = math.prod(probs[j][k] for j, k in enumerate(counts))
29 +         score = max(
30 +             (a + counts[j]) / (a + b + budget[j]) for j, (a, b) in enumerate(arms)
31 +         )
32 +         gross += p * score
33 +     return gross - current
34 +
35 +
36 + dom = [(F(12), F(2)), (F(2), F(12))]
37 + budget = [1, 1]
38 + winner = 0
39 + low = dom[0][0] / (sum(dom[0]) + 1)
40 + other_high = (dom[1][0] + 1) / (sum(dom[1]) + 1)
41 + assert low == F(4, 5) and other_high == F(1, 5) and low > other_high
42 + assert EVSI(dom, budget) == 0
43 + nonzero = [(F(1), F(1)), (F(1), F(1))]
44 + g = EVSI(nonzero, [1, 1])
45 + assert g == F(1, 12)
46 + variances = []
47 + for a, b in nonzero:
48 +     s = a + b
49 +     v = F(1) * a * b / (s * s * (s + 1) * (s + 1))
50 +     variances.append(v)
51 + assert variances == [F(1, 36), F(1, 36)]
52 + bound = sqrt(float(sum(variances))) / 2
53 + assert bound > float(g) and abs(bound - sqrt(2) / 12) < 1e-15
54 + a, b, n = F(5), F(3), 2
