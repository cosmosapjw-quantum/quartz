43  +         if int(a) != a or int(b) != b:
44  +             raise ValueError("C10 prototype integer posterior shapes only")
45  +         probs = polya_pmf(a, b, n)
46  +         scores = [Fraction(int(a) + k, int(a) + int(b) + n) for k in range(n + 1)]
47  +         distributions.append(list(zip(scores, probs)))
48  +     support = sorted(set(s for arm in distributions for s, _ in arm))
49  +     previous = 0.0
50  +     mean_best = 0.0
51  +     for v in support:
