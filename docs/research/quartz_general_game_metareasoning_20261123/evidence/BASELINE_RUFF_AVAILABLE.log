107 + def pair_summary(outcomes, a, b):
108 +     if not outcomes:
109 +         raise ValueError("no root pairs")
110 +     n = len(outcomes)
111 +     xs = [z[a] for z in outcomes]
112 +     ys = [z[b] for z in outcomes]
113 +     ca = sum(z["cost_us"] for z in xs) / n
114 +     cb = sum(z["cost_us"] for z in ys) / n
115 +     if not ca > 0 or not cb > 0:
116 +         raise ValueError("positive CPU time required")
117 +     mismatch = abs(ca - cb) / ca
118 +     win = sum(z["is_immediate_win"] for z in xs) - sum(
119 +         z["is_immediate_win"] for z in ys
120 +     )
121 +     agree = sum(z["teacher_agree"] for z in xs) - sum(z["teacher_agree"] for z in ys)
122 +     return {
123 +         "n": n,
124 +         "local_immediate_win_difference": win,
125 +         "teacher_exact_agreement_difference": agree,
126 +         "mean_CPU_wall_us_A": ca,
127 +         "mean_CPU_wall_us_B": cb,
128 +         "CPU_mean_relative_mismatch": mismatch,
129 +         "cpu_10pct_match": "MATCHED_10_PERCENT"
130 +         if mismatch <= 0.1
131 +         else "NOT_MATCHED_10_PERCENT",
132 +         "A_minus_B_immediate_win_rate": win / n,
133 +         "A_minus_B_teacher_agree_rate": agree / n,
134 +         "finite_positions_only_not_population_inference": True,
135 +     }
