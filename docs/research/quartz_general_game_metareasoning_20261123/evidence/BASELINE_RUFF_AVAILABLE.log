73  + def source_reference_beta_evsi(posterior, budgets):
74  +     # Independently written Pólya-urn predictive distributions, not native Rust source.
75  +     # The repeated Bernoulli observations share arm theta, so counts are Beta-Binomial.
76  +     arms = []
77  +     for (a, b), n in zip(posterior, budgets):
78  +         p = math.prod((b + i) / (a + b + i) for i in range(n))
79  +         probs = [p]
80  +         for k in range(n):
81  +             p *= ((n - k) / (k + 1)) * ((a + k) / (b + n - k - 1))
82  +             probs.append(p)
83  +         assert abs(math.fsum(probs) - 1) < 1e-9
84  +         arms.append([((a + k) / (a + b + n), probs[k]) for k in range(n + 1)])
85  +     support = sorted(set(v for m in arms for v, p in m))
86  +     last = 0.0
87  +     prev = 0.0
88  +     expected = 0.0
89  +     for v in support:
90  +         expected += (v - last) * (1 - prev)
91  +         prev = math.prod(math.fsum(p for x, p in arm if x <= v) for arm in arms)
92  +         last = v
93  +     assert abs(prev - 1) < 1e-8
94  +     M = max(a / (a + b) for a, b in posterior)
95  +     return max(0.0, expected - M)
