167 + def native_sensor_model_batch(rows: Sequence[Mapping]) -> tuple[list[dict], dict]:
168 +     if sha(SENSOR) != SENSOR_SHA256:
169 +         raise ValueError("immutable C20 native sensor source SHA mismatch")
170 +     cases = [sensor_public_case(row) for row in rows]
171 +     assert all(set(r) == {"prior", "likelihood", "utilities", "extra"} for r in cases)
172 +     with tempfile.TemporaryDirectory(prefix="quartz_c21_sensor_input_") as tmp:
173 +         path = Path(tmp) / "C21_SENSOR_MODEL_ONLY.json"
174 +         path.write_text(json.dumps({"cases": cases}, sort_keys=True))
175 +         t0 = time.perf_counter_ns()
176 +         raw = subprocess.check_output([str(SENSOR), str(path)], text=True)
177 +         elapsed = (time.perf_counter_ns() - t0) / 1000
178 +     record = json.loads(raw)
179 +     assert (
180 +         record["no_SearchPolicy_mutation"] is True
181 +         and record["beta_binomial_Rust_port"] is False
182 +     )
183 +     assert len(record["predictions"]) == len(rows)
184 +     out = [
185 +         {
186 +             "gross_exact_EVSI": float(v["evsi"]),
187 +             "native_predictor_function_internal_us": float(v["evaluation_us"]),
188 +             "before_posterior_expected_best": float(v["before_best"]),
189 +             "exact_predictive_mass": float(v["total_predictive_mass"]),
190 +             "unique_support_points": int(v["outcome_count"]),
191 +         }
192 +         for v in record["predictions"]
193 +     ]
194 +     return out, {
195 +         "total_cold_batch_host_us": elapsed,
196 +         "amortized_batch_host_us_per_case": elapsed / len(rows),
197 +         "sensor_model_host_scope": "one Rust process for all cases; no per-case streaming/JSON boundary",
198 +     }
