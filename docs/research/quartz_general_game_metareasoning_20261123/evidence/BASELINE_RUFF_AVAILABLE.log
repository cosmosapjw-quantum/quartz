57 + avg = sum(x * p for x, p in zip(score, pr))
58 + var = sum(p * (x - avg) ** 2 for x, p in zip(score, pr))
59 + formula = F(n) * a * b / ((a + b) ** 2 * (a + b + 1) * (a + b + n))
60 + assert pr == [F(1, 6), F(5, 12), F(5, 12)]
61 + assert avg == F(5, 8) and var == formula == F(1, 192)
